---
const navItems = [
  { label: 'Buttons', href: '#buttons' },
  { label: 'Cards', href: '#cards' },
  { label: 'Forms', href: '#forms' },
  { label: 'Badges', href: '#badges' },
  { label: 'Alerts', href: '#alerts' },
  { label: 'Modals', href: '#modals' },
];
---

<header class="lb-header">
  <div class="lb-header-inner">
    <a href="/" class="lb-logo">
      <span class="lb-logo-icon"> breeze</span>
      <span class="lb-logo-text">UI</span>
    </a>

    <button class="lb-menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="lb-menu-icon"></span>
    </button>

    <nav class="lb-nav" id="main-nav" role="navigation" aria-label="Main navigation">
      <ul class="lb-nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="lb-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button id="theme-toggle" class="lb-button lb-button-secondary lb-button-sm" aria-label="Toggle theme">
      <span id="theme-icon">☀️</span>
      <span id="theme-text" class="lb-sr-only">Light</span>
    </button>
  </div>
</header>

<script>
  const themes = ['light', 'dark', 'muted'];
  const themeIcons: Record<string, string> = { light: '☀️', dark: '🌙', muted: '🫧' };
  const themeLabels: Record<string, string> = { light: 'Aero', dark: 'WMP', muted: 'Muted' };

  const toggle = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-icon');
  const text = document.getElementById('theme-text');
  const menuToggle = document.getElementById('menu-toggle');
  const mainNav = document.getElementById('main-nav');

  function updateButton(theme: string) {
    if (icon) icon.textContent = themeIcons[theme] || '☀️';
    if (text) text.textContent = themeLabels[theme] || 'Light';
  }

  const savedTheme = localStorage.getItem('theme') || 'light';
  document.documentElement.setAttribute('data-theme', savedTheme);
  updateButton(savedTheme);

  toggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const idx = themes.indexOf(current);
    const next = themes[(idx + 1) % themes.length];
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateButton(next);
  });
  
  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    mainNav?.classList.toggle('lb-nav-open');
  });
  
  // Close menu on link click
  document.querySelectorAll('.lb-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menuToggle?.setAttribute('aria-expanded', 'false');
      mainNav?.classList.remove('lb-nav-open');
    });
  });
</script>

<style>
  .lb-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--lb-bg-card);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--lb-border-light);
    padding: 0.75rem 1.5rem;
  }

  .lb-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lb-logo {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--lb-text-primary);
  }

  .lb-logo-icon {
    color: var(--lb-primary-500);
  }

  .lb-logo-text {
    color: var(--lb-primary-500);
  }

  .lb-nav-list {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .lb-nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--lb-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--lb-border-radius-sm);
    transition: all 0.2s ease;
  }

  .lb-nav-link:hover {
    color: var(--lb-primary-500);
    background: rgba(0, 115, 230, 0.1);
  }

  .lb-menu-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .lb-menu-icon {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--lb-text-primary);
    position: relative;
    transition: background 0.2s ease;
  }

  .lb-menu-icon::before,
  .lb-menu-icon::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: inherit;
    transition: transform 0.2s ease;
  }

  .lb-menu-icon::before {
    top: -6px;
  }

  .lb-menu-icon::after {
    top: 6px;
  }

  .lb-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .lb-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lb-nav {
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      background: var(--lb-bg-card);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--lb-border-light);
      padding: 1rem;
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .lb-nav.lb-nav-open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .lb-nav-list {
      flex-direction: column;
      gap: 0.5rem;
    }

    .lb-nav-link {
      padding: 0.75rem 1rem;
    }
  }
</style>
