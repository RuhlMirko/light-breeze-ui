---
import SectionHeader from '../SectionHeader.astro';
---

<section class="lb-card lb-section" id="alerts">
  <SectionHeader title="Alerts" />
  <div class="lb-card-body">
    <div class="lb-flex lb-flex-wrap lb-items-center lb-justify-center lb-gap-md lb-mb-lg">
      <button class="lb-button lb-button-secondary" data-show-alert="info">Show Info</button>
      <button class="lb-button lb-button-secondary" data-show-alert="success">Show Success</button>
      <button class="lb-button lb-button-secondary" data-show-alert="warning">Show Warning</button>
      <button class="lb-button lb-button-secondary" data-show-alert="danger">Show Danger</button>
    </div>
    <div id="toast-container" class="lb-toast-container"></div>
    <div class="lb-mt-lg lb-code-block">
      <code class="lb-text-sm">&lt;div class="lb-alert lb-alert-info"&gt;...&lt;/div&gt;</code>
    </div>
  </div>
</section>

<script>
  const alerts: Record<string, { icon: string; title: string; message: string }> = {
    info: { icon: 'ℹ️', title: 'Info', message: 'This is an informational alert message.' },
    success: { icon: '✅', title: 'Success', message: 'Your action was completed successfully!' },
    warning: { icon: '⚠️', title: 'Warning', message: 'Please be aware of this important notice.' },
    danger: { icon: '❌', title: 'Error', message: 'Something went wrong. Please try again.' }
  };

  function showToast(type: string) {
    const data = alerts[type];
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `lb-toast lb-toast-${type}`;
    toast.innerHTML = `
      <span class="lb-toast-icon">${data.icon}</span>
      <div class="lb-toast-content">
        <div class="lb-toast-title">${data.title}</div>
        <div class="lb-toast-message">${data.message}</div>
      </div>
      <button class="lb-toast-close">&times;</button>
    `;
    container.appendChild(toast);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        toast.classList.add('show');
      });
    });

    const closeBtn = toast.querySelector('.lb-toast-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        toast.classList.remove('show');
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 400);
      });
    }

    setTimeout(() => {
      if (toast.parentNode) {
        toast.classList.remove('show');
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 400);
      }
    }, 4000);
  }

  document.querySelectorAll('[data-show-alert]').forEach(btn => {
    btn.addEventListener('click', () => {
      showToast(btn.getAttribute('data-show-alert') || '');
    });
  });
</script>

<style>
  .lb-section {
    min-height: 300px;
  }

  .lb-code-block {
    background: var(--lb-gray-100);
    padding: 1rem;
    border-radius: var(--lb-border-radius-sm);
  }
</style>
